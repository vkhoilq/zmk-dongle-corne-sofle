#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 25
#define LOWER   1
#define RAISE   2

/ {
    behaviors {
        ///// Start OS KKey  ///////////////////
        /* ── OS selector ────────────────────────────────────────────── */

        os_sel: os_selector {
            compatible = "zmk,behavior-os-selector";
            #binding-cells = <1>;
        };

        /* ── Commands ─────────────────────────────────────────────── */

        ok_cut: os_key_cut {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*             Win           Mac           Lin  */

            bindings = <&kp LC(X)>, <&kp LG(X)>, <&kp LC(X)>;
        };

        ok_copy: os_key_copy {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*             Win           Mac           Lin  */

            bindings = <&kp LC(C)>, <&kp LG(C)>, <&kp LC(C)>;
        };

        ok_paste: os_key_paste {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*             Win           Mac           Lin  */

            bindings = <&kp LC(V)>, <&kp LG(V)>, <&kp LC(V)>;
        };

        ok_undo: os_key_undo {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*             Win           Mac           Lin  */

            bindings = <&kp LC(Z)>, <&kp LG(Z)>, <&kp LC(Z)>;
        };

        ok_redo: os_key_redo {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*             Win         Mac                Lin  */

            bindings = <&kp LC(Y)>, <&kp LS(LG(Z))>, <&kp LS(LC(Z))>;
        };

        ok_sel_all: os_key_select_all {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*             Win           Mac           Lin  */

            bindings = <&kp LC(A)>, <&kp LG(A)>, <&kp LC(A)>;
        };

        ok_find: os_key_find {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*             Win           Mac           Lin  */

            bindings = <&kp LC(F)>, <&kp LG(F)>, <&kp LC(F)>;
        };

        ok_find_replace: os_key_find_replace {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*             Win           Mac           Lin  */

            bindings = <&kp LC(H)>, <&kp LG(H)>, <&kp LC(H)>;
        };

        ok_bold: os_key_bold {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*             Win           Mac           Lin  */

            bindings = <&kp LC(B)>, <&kp LG(B)>, <&kp LC(B)>;
        };

        ok_italic: os_key_italic {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*             Win           Mac           Lin  */

            bindings = <&kp LC(I)>, <&kp LG(I)>, <&kp LC(I)>;
        };

        ok_underline: os_key_underline {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*             Win           Mac           Lin  */

            bindings = <&kp LC(U)>, <&kp LG(U)>, <&kp LC(U)>;
        };

        ok_new_win: os_key_new_window {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*             Win           Mac           Lin  */

            bindings = <&kp LC(N)>, <&kp LG(N)>, <&kp LC(N)>;
        };

        ok_new_tab: os_key_new_tab {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*             Win           Mac           Lin  */

            bindings = <&kp LC(T)>, <&kp LG(T)>, <&kp LC(T)>;
        };

        ok_close: os_key_close {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*             Win           Mac           Lin  */

            bindings = <&kp LC(W)>, <&kp LG(W)>, <&kp LC(W)>;
        };

        ok_quit: os_key_quit {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*             Win            Mac           Lin  */

            bindings = <&kp LA(F4)>, <&kp LG(Q)>, <&kp LA(F4)>;
        };

        ok_reopen_tab: os_key_reopen_tab {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*                  Win                Mac               Lin  */

            bindings = <&kp LS(LC(T))>, <&kp LS(LG(T))>, <&kp LS(LC(T))>;
        };

        ok_open: os_key_open {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*             Win           Mac           Lin  */

            bindings = <&kp LC(O)>, <&kp LG(O)>, <&kp LC(O)>;
        };

        ok_save: os_key_save {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*             Win           Mac           Lin  */

            bindings = <&kp LC(S)>, <&kp LG(S)>, <&kp LC(S)>;
        };

        ok_save_as: os_key_save_as {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*                  Win                Mac               Lin  */

            bindings = <&kp LS(LC(S))>, <&kp LS(LG(S))>, <&kp LS(LC(S))>;
        };

        ok_print: os_key_print {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*             Win           Mac           Lin  */

            bindings = <&kp LC(P)>, <&kp LG(P)>, <&kp LC(P)>;
        };

        ok_zoom_in: os_key_zoom_in {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*                Win              Mac              Lin  */

            bindings = <&kp LC(EQUAL)>, <&kp LG(EQUAL)>, <&kp LC(EQUAL)>;
        };

        ok_zoom_out: os_key_zoom_out {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*                Win              Mac              Lin  */

            bindings = <&kp LC(MINUS)>, <&kp LG(MINUS)>, <&kp LC(MINUS)>;
        };

        ok_zoom_reset: os_key_zoom_reset {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*             Win            Mac            Lin  */

            bindings = <&kp LC(N0)>, <&kp LG(N0)>, <&kp LC(N0)>;
        };

        /* ── Navigation ─────────────────────────────────────────────── */

        ok_prev_word: os_key_prev_word {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*                  Win            Mac            Lin  */

            bindings = <&kp LC(LEFT)>, <&kp LA(LEFT)>, <&kp LC(LEFT)>;
        };

        ok_next_word: os_key_next_word {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*                  Win             Mac             Lin  */

            bindings = <&kp LC(RIGHT)>, <&kp LA(RIGHT)>, <&kp LC(RIGHT)>;
        };

        ok_line_start: os_key_line_start {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*              Win          Mac             Lin  */

            bindings = <&kp HOME>, <&kp LG(LEFT)>, <&kp HOME>;
        };

        ok_line_end: os_key_line_end {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*             Win           Mac              Lin  */

            bindings = <&kp END>, <&kp LG(RIGHT)>, <&kp END>;
        };

        ok_doc_start: os_key_doc_start {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*                Win           Mac          Lin  */

            bindings = <&kp LC(HOME)>, <&kp LG(UP)>, <&kp LC(HOME)>;
        };

        ok_doc_end: os_key_doc_end {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*               Win             Mac            Lin  */

            bindings = <&kp LC(END)>, <&kp LG(DOWN)>, <&kp LC(END)>;
        };

        /* ── Selection (Shift + Navigation) ─────────────────────────── */

        ok_sel_prev_word: os_key_sel_prev_word {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*                       Win                   Mac                   Lin  */

            bindings =
                <&kp LS(LC(LEFT))>,
                <&kp LS(LA(LEFT))>,
                <&kp LS(LC(LEFT))>;
        };

        ok_sel_next_word: os_key_sel_next_word {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*                        Win                    Mac                    Lin  */

            bindings =
                <&kp LS(LC(RIGHT))>,
                <&kp LS(LA(RIGHT))>,
                <&kp LS(LC(RIGHT))>;
        };

        ok_sel_line_start: os_key_sel_line_start {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*                   Win              Mac                Lin  */

            bindings = <&kp LS(HOME)>, <&kp LS(LG(LEFT))>, <&kp LS(HOME)>;
        };

        ok_sel_line_end: os_key_sel_line_end {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*                  Win             Mac                 Lin  */

            bindings = <&kp LS(END)>, <&kp LS(LG(RIGHT))>, <&kp LS(END)>;
        };

        ok_sel_doc_start: os_key_sel_doc_start {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*                     Win                Mac               Lin  */

            bindings = <&kp LS(LC(HOME))>, <&kp LS(LG(UP))>, <&kp LS(LC(HOME))>;
        };

        ok_sel_doc_end: os_key_sel_doc_end {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*                    Win                 Mac                Lin  */

            bindings = <&kp LS(LC(END))>, <&kp LS(LG(DOWN))>, <&kp LS(LC(END))>;
        };

        /* ── Window management ───────────────────────────────────────── */
        /* Linux shortcuts are DE-specific; override in your keymap.     */

        ok_ltm: os_layer_mod {
            compatible = "zmk,behavior-os-layer-mod";
            #binding-cells = <2>;

            /*
             * Hold: activates <layer> and holds the OS app-switch modifier,
             *   keeping the switcher menu open while held.
             * Tap: sends <keycode> normally.
             * Release: dismisses the switcher menu and deactivates the layer.
             *
             * Usage:  &ok_ltm APP_SWITCH_LAYER G
             *
             * Override mods in your keymap to use different modifiers.
             */

            tapping-term-ms = <200>;

            /*              Win           Mac           Lin  */

            bindings = <&kp LALT>, <&kp LGUI>, <&kp LGUI>;
        };

        ok_next_app: os_key_next_app {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*            Win           Mac           Lin  */

            bindings = <&kp LA(TAB)>, <&kp LG(TAB)>, <&kp LG(TAB)>;
        };

        ok_prev_app: os_key_prev_app {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*            Win           Mac           Lin  */

            bindings = <&kp LS(LA(TAB))>, <&kp LS(LG(TAB))>, <&kp LS(LG(TAB))>;
        };

        ok_next_tab: os_key_next_tab {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*            Win           Mac              Lin  */

            bindings = <&kp LC(RBRC)>, <&kp LG(RBRC)>, <&kp LC(PG_DN)>;
        };

        ok_prev_tab: os_key_prev_tab {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*            Win           Mac              Lin  */

            bindings = <&kp LC(LBRC)>, <&kp LG(LBRC)>, <&kp LC(PG_UP)>;
        };

        ok_mission_ctrl: os_key_mission_control {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*                 Win            Mac          Lin (DE-specific) */

            bindings = <&kp LG(TAB)>, <&kp LC(UP)>, <&kp LGUI>;
        };

        ok_desktop: os_key_desktop {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*              Win           Mac             Lin (DE-specific) */

            bindings = <&kp LG(D)>, <&kp LG(LC(D))>, <&kp LG(D)>;
        };

        ok_lock: os_key_lock {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*               Win           Mac              Lin (Ubuntu/GNOME default) */

            bindings = <&kp LG(L)>, <&kp LG(LC(Q))>, <&kp LG(L)>;
        };

        ok_force_quit: os_key_force_quit {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*                  Win (Task Mgr)    Mac (Force Quit)    Lin (KDE: Sys Activity) */

            bindings = <&kp LS(LC(ESC))>, <&kp LA(LG(ESC))>, <&kp LC(ESC)>;
        };

        ///// Finish OS KKey  ///////////////////

        leader1: leader1 {
            compatible = "zmk,behavior-leader-key";
            #binding-cells = <0>;

            usb {
                sequence = <U S B>;
                bindings = <&out OUT_USB>;
            };

            ble {
                sequence = <B L E>;
                bindings = <&out OUT_BLE>;
            };

            bt0 {
                sequence = <B N0>;
                bindings = <&bt BT_SEL 0>;
            };

            bt1 {
                sequence = <B N1>;
                bindings = <&bt BT_SEL 1>;
            };

            bt2 {
                sequence = <B N2>;
                bindings = <&bt BT_SEL 2>;
            };

            btc {
                sequence = <C L E A R>;
                bindings = <&bt BT_CLR>;
            };

            boot {
                sequence = <B O O T>;
                bindings = <&bootloader>;
            };

            reset {
                sequence = <R E S E T>;
                bindings = <&sys_reset>;
            };
        };

        layer_tap_repeat: layer_tap_repeat {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_REPEAT";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            flavor = "tap-preferred";
        };

        mmv_fast: mmv_fast {
                compatible = "zmk,behavior-input-two-axis";
                #binding-cells = <1>;
                x-input-code = <INPUT_REL_X>;
                y-input-code = <INPUT_REL_Y>;
                time-to-max-speed-ms = <50>;   // Almost instant acceleration (default is 300)
                acceleration-exponent = <1>;
        };
        my_fast_lt: my_fast_lt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";    // Defines how overlaps are handled
            tapping-term-ms = <200>;     // Time to trigger the hold behavior
            //quick-tap-ms = <150>;        // Allows repeated taps without triggering the layer

            require-prior-idle-ms = <200>; // Prevents accidental layer activation during fast typing
            bindings = <&mo>, <&kp>;

            // Hold = Layer, Tap = Key

            quick-tap-ms = <50>;
        };

        hrl: hrl {
            compatible = "zmk,behavior-hold-tap";
            label = "HRL";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <1>;
            hold-trigger-key-positions = <7 6 18 30 31 19 8 20 32 33 9 21 34 22 10 11 23 35>;
        };

        hrm: hrm {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <1>;
            hold-trigger-key-positions = <0 12 24 25 13 1 2 14 26 27 15 3 4 28 16 29 17 5>;
        };

        mod_rgb_effect: mod_rgb_effect {
            compatible = "zmk,behavior-mod-morph";
            label = "MOD_RGB_EFFECT";
            bindings = <&rgb_ug RGB_EFF>, <&rgb_ug RGB_EFR>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
            keep-mods = <(MOD_LSFT)>;
        };

        mod_rgb_hue: mod_rgb_hue {
            compatible = "zmk,behavior-mod-morph";
            label = "MOD_RGB_HUE";
            bindings = <&rgb_ug RGB_HUI>, <&rgb_ug RGB_HUD>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
            keep-mods = <(MOD_LSFT)>;
        };

        mod_rgb_sat: mod_rgb_sat {
            compatible = "zmk,behavior-mod-morph";
            label = "MOD_RGB_SAT";
            bindings = <&rgb_ug RGB_SAI>, <&rgb_ug RGB_SAD>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
            keep-mods = <(MOD_LSFT)>;
        };

        mod_rgb_brightness: mod_rgb_brightness {
            compatible = "zmk,behavior-mod-morph";
            label = "MOD_RGB_BRIGHTNESS";
            bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
            keep-mods = <(MOD_LSFT)>;
        };

        mod_ext_power: mod_ext_power {
            compatible = "zmk,behavior-mod-morph";
            label = "MOD_EXT_POWER";
            bindings = <&ext_power EP_TOG>, <&ext_power EP_OFF>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
            keep-mods = <(MOD_LSFT)>;
        };

        mod_output: mod_output {
            compatible = "zmk,behavior-mod-morph";
            label = "MOD_OUTPUT";
            bindings = <&out OUT_TOG>, <&out OUT_USB>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
            keep-mods = <(MOD_LSFT)>;
        };

        mod_bt_choose_0: mod_bt_choose_0 {
            compatible = "zmk,behavior-mod-morph";
            label = "MOD_BT_CHOOSE_0";
            bindings = <&bt BT_SEL 0>, <&bt BT_CLR>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
            keep-mods = <(MOD_LSFT)>;
        };

        mod_bt_choose_1: mod_bt_choose_1 {
            compatible = "zmk,behavior-mod-morph";
            label = "MOD_BT_CHOOSE_1";
            bindings = <&bt BT_SEL 1>, <&bt BT_CLR>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
            keep-mods = <(MOD_LSFT)>;
        };

        mod_bt_choose_2: mod_bt_choose_2 {
            compatible = "zmk,behavior-mod-morph";
            label = "MOD_BT_CHOOSE_2";
            bindings = <&bt BT_SEL 2>, <&bt BT_CLR>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
            keep-mods = <(MOD_LSFT)>;
        };

        mod_bt_choose_3: mod_bt_choose_3 {
            compatible = "zmk,behavior-mod-morph";
            label = "MOD_BT_CHOOSE_3";
            bindings = <&bt BT_SEL 3>, <&bt BT_CLR>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
            keep-mods = <(MOD_LSFT)>;
        };

        tly_mouse: tly_mouse {
            compatible = "zmk,behavior-toggle-layer";
            label = "TLY_MOUSE";
            #binding-cells = <1>;
        };
    };

    combos {
        compatible = "zmk,combos";


        Genpd1 {
            bindings = <&wp1>;
            key-positions = <10 22 34>;
            layers = <2>;
        };

        Genpd2 {
            bindings = <&wp2>;
            key-positions = <9 21 33>;
            layers = <2>;
        };


        cmbRaycast {
            bindings = <&kp LA(ENTER)>;
            key-positions = <38 39>;
            layers = <0 1>;
        };

        To_Mouse {
            bindings = <&to 3>;
            key-positions = <2 14 26>;
        };

        To_Nav {
            bindings = <&to 2>;
            key-positions = <1 13 25>;
        };

        ToDef {
            bindings = <&to 0>;
            key-positions = <3 15 27>;
        };
        cmbRepeatL {
            bindings = <&key_repeat>;
            key-positions = <39 40>;
            timeout-ms = <50>;
        };

        cmbRepeatR {
            bindings = <&key_repeat>;
            key-positions = <45 46>;
            timeout-ms = <50>;
        };
        CmbRaycastChat {
            bindings = <&kp LA(SPACE)>;
            key-positions = <53 56>;
            layers = <0>;
        };

    };

    macros {
        wp1: wp1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp AT &kp LS(T) &kp I &kp N0 &kp N2 &kp C &kp A &kp N0 &kp N9 &kp ENTER>;
            label = "WP1";
        };

        wp2: wp3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp AT &kp LS(A) &kp N &kp H &kp K &kp H &kp O &kp I &kp N1 &kp N4 &kp B &kp E &kp N &kp G &kp O &kp C &kp ENTER>;
            label = "WP3";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Default_layer {
            bindings = <
&none  &kp Q            &kp W            &kp F                &kp J              &kp COMMA    &kp PERIOD      &kp L               &kp U                 &kp Y            &kp SQT           &kp C_VOLUME_UP
&none  &hrl LEFT_GUI A  &hrl LEFT_ALT R  &hrl LEFT_CONTROL S  &hrl LEFT_SHIFT T  &kp G        &kp M           &hrm RIGHT_SHIFT N  &hrm RIGHT_CONTROL E  &hrm LEFT_ALT I  &hrm RIGHT_GUI O  &kp C_VOLUME_DOWN
&none  &kp Z            &kp X            &kp C                &kp D              &kp V        &kp K           &kp H               &kp P                 &kp B            &kp FSLH          &kp K_MUTE
                                         &lt 8 ESCAPE         &lt 2 SPACE        &lt 3 TAB    &lt 4 KP_ENTER  &lt 5 BACKSPACE     &lt 6 RIGHT_ALT
            >;

            label = "DEF";
        };

        Alternative {
            bindings = <
&none  &kp Q            &kp W            &kp E                &kp R              &kp T        &kp Y           &kp U               &kp I                 &kp O            &kp P                     &none
&none  &hrl LEFT_GUI A  &hrl LEFT_ALT S  &hrl LEFT_CONTROL D  &hrl LEFT_SHIFT F  &kp G        &kp H           &hrm RIGHT_SHIFT J  &hrm RIGHT_CONTROL K  &hrm LEFT_ALT L  &hrm RIGHT_GUI SEMICOLON  &none
&none  &kp Z            &kp X            &kp C                &kp V              &kp B        &kp N           &kp M               &kp COMMA             &kp DOT          &kp FSLH                  &none
                                         &lt 8 ESCAPE         &lt 2 SPACE        &lt 3 TAB    &lt 4 KP_ENTER  &lt 5 BACKSPACE     &lt 6 RIGHT_ALT
            >;

            label = "ALT";
        };

        Nav {
            bindings = <
&none  &bootloader   &none         &none             &none                     &tog 2                   &kp LS(LG(Z))  &kp LG(V)      &kp LG(C)       &kp LG(X)     &kp LG(Z)        &none
&none  &kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT            &none                    &caps_word     &kp LEFT       &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &none
&none  &none         &none         &none             &sk LS(LA(LC(LEFT_GUI)))  &kp LS(LA(LC(LG(V))))    &kp INSERT     &kp HOME       &kp PAGE_DOWN   &kp PAGE_UP   &kp END          &none
                                   &none             &none                     &none                    &kp ENTER      &kp BACKSPACE  &kp DELETE
            >;

            label = "NAV";
        };

        Mouse {
            bindings = <
&none  &bootloader   &none         &none             &none           &tog 3                  &kp K_AGAIN  &kp K_PASTE     &kp K_COPY      &kp K_CUT     &kp K_UNDO       &none
&none  &kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &kp LS(LG(NUMBER_4))    &none        &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &none
&none  &none         &none         &kp RIGHT_ALT     &none           &none                   &none        &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &none
                                   &none             &none           &none                   &mkp MB2     &mkp MB1        &mkp MB3
            >;

            label = "MOUSE";
        };

        Symbol {
            bindings = <
&none  &kp LEFT_BRACE  &kp AMPERSAND    &kp ASTERISK          &kp LEFT_PARENTHESIS   &kp RIGHT_BRACE    &none  &none      &none      &none     &none     &none
